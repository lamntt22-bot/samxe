SUPABASE_URL=
# Server-only secret key (bypasses RLS) — from Supabase dashboard:
# Project Settings -> API Keys -> "secret key" (sb_secret_...) or legacy "service_role"
# Do NOT use the sb_publishable_... key here, and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=

# Random secret used to sign session JWTs. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
